{
  "info": {
    "name": "LMS Backend API Automated Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": ["{{baseUrl}}"],
          "path": ["actuator", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "User Registration",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var uniqueEmail = 'newman_' + Date.now() + '@lms.com';",
              "pm.variables.set('uniqueEmail', uniqueEmail);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200 && pm.response.code !== 201) {",
              "    console.log('Response Status:', pm.response.code);",
              "    console.log('Response Body:', pm.response.text());",
              "}",
              "pm.test('Registration returns 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Newman Test User\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"password\": \"Password123!\",\n  \"role\": \"ROLE_STUDENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    }
  ]
}
